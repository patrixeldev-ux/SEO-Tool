# Dev image for the Vite web app. Source is bind-mounted by docker-compose.dev.yml;
# node_modules lives in a named volume so Windows and Linux binaries never mix.
FROM node:22-alpine

# Absolute store path on purpose. pnpm's default store lives under $HOME; when the project (/app) is a bind mount
# on another device, pnpm silently moves the store to /app/.pnpm-store, i.e. INTO the Windows folder: ~11k files
# over the slow Windows mount, a 3-minute reinstall on every start, and a Vite watcher that hangs polling them.
ENV npm_config_package_import_method=copy \
    npm_config_store_dir=/pnpm-store \
    CI=true

RUN npm install -g pnpm@10.28.0

WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
EXPOSE 5173
CMD ["pnpm", "dev", "--host", "0.0.0.0", "--port", "5173"]
