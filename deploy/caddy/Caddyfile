# One public origin:   /      -> the built web app (static files, falls back to index.html)
#                      /api/* -> the API, with the "/api" prefix removed
# SITE_ADDRESS is the host name (DOMAIN in .env.prod), e.g. 152-67-1-2.sslip.io. Caddy gets and renews the
# Let's Encrypt certificate by itself (needs ports 80 and 443 open to the internet). For "localhost" Caddy uses its
# own local CA automatically; CADDY_TLS_INTERNAL=1 forces that for any host name.
{
	servers {
		protocols h1 h2
	}
}

{$SITE_ADDRESS} {
	# tls.caddy is copied from tls-0.caddy or tls-1.caddy when the container starts (see docker-compose.prod.yml).
	import /etc/caddy/tls.caddy

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	handle_path /api/* {
		request_body {
			max_size 10MB
		}
		reverse_proxy api:8000 {
			# Sets X-Forwarded-For / -Proto / -Host for uvicorn --proxy-headers.
			lb_try_duration 5s
			transport http {
				read_timeout 120s
			}
		}
	}

	handle {
		request_body {
			max_size 1MB
		}
		root * /srv
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
