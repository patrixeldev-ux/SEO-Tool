# Production settings. deploy/oracle/install.sh creates .env.prod from this the first time (with strong random
# secrets) and never overwrites it afterwards. .env.prod is git-ignored. Never commit it or share it.
# Edit with:  nano ~/seo-tool/.env.prod   then:  deploy/oracle/update.sh   (restarts with the new values)

# Host name of the site. Default: your public IP with dashes + .sslip.io (free, works without a domain,
# and Caddy gets a real HTTPS certificate for it). Use your own domain here once you have one.
DOMAIN=203-0-113-10.sslip.io
# 1 = use Caddy's local certificate authority instead of Let's Encrypt (testing only: browsers will warn).
CADDY_TLS_INTERNAL=0

# --- Secrets (generated by install.sh; do not change after first start) ----------------------------------------
POSTGRES_USER=searchos
POSTGRES_DB=searchos
POSTGRES_PASSWORD=
JWT_SECRET=
# Encrypts stored Google tokens and API keys. If you lose it, connections must be re-created.
TOKEN_ENCRYPTION_KEY=

# 'false': nobody can sign up from the web page; make accounts with deploy/oracle/create-admin.sh.
ALLOW_REGISTRATION=false

# --- Optional integrations (see docs/GOOGLE_SETUP.md; restart with deploy/oracle/update.sh after editing) -------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PSI_API_KEY=
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# GEMINI_API_KEY=
# GEMINI_MODEL=

# --- Memory ceilings (defaults suit 6-12 GB; raise WORKER_MEM_LIMIT on a 24 GB VM) ---------------------------------
# WORKER_MEM_LIMIT=3g
# API_MEM_LIMIT=1536m
# POSTGRES_MEM_LIMIT=1536m
# PG_SHARED_BUFFERS=256MB
# API_WORKERS=2
