# Copy to .env (PowerShell: Copy-Item .env.example .env) and adjust. .env is git-ignored; never commit it.
# Secrets are read from the environment ONLY; the app refuses to start without DATABASE_URL and JWT_SECRET.

# --- General -----------------------------------------------------------------------------------------
# development | test | production. In production: Secure cookies, API docs off, demo endpoints off,
# and the placeholder JWT_SECRET below is rejected at startup.
ENVIRONMENT=development

# --- Postgres / Redis containers (docker-compose.dev.yml) ---------------------------------------------
POSTGRES_USER=searchos
POSTGRES_PASSWORD=searchos
POSTGRES_DB=searchos
# Host ports for the Postgres/Redis containers. Deliberately NOT 5432/6379 so they never clash with another
# Postgres/Redis (or another project's containers) on your machine. The containers talk to each other on the
# internal Docker network; these ports are only for running the API or tests directly on your machine.
POSTGRES_PORT=55432
REDIS_PORT=56379

# --- Backend ------------------------------------------------------------------------------------------
# Used when you run the API/worker directly on your machine. docker-compose.dev.yml overrides the host
# names (postgres, redis) for the containers, so you do not need to change these for Docker.
DATABASE_URL=postgresql+asyncpg://searchos:searchos@localhost:55432/searchos
REDIS_URL=redis://localhost:56379/0

# Signs access tokens (HS256). Min 32 chars. Generate a real one for anything beyond local dev:
#   PowerShell:  [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
#   Python:      python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789

# Exact origins allowed to call the API with credentials, comma-separated. No wildcard.
CORS_ORIGINS=http://localhost:5173

# Token lifetimes (defaults shown).
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30

# Force the refresh cookie's Secure flag on/off. Leave unset: it is on automatically in production.
# COOKIE_SECURE=true

# --- Web ----------------------------------------------------------------------------------------------
# Where the browser finds the API (baked into the Vite dev server).
VITE_API_URL=http://localhost:8000

# --- Search Console / Google (optional) ---------------------------------------------------------------
# Everything below is optional: the app starts and every earlier feature works with these unset.
# Step-by-step setup for a non-developer: docs/GOOGLE_SETUP.md
#
# Google OAuth client (type "Web application"). Without these, Settings > Integrations shows
# "Google isn't set up yet".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Must match, character for character, the "Authorized redirect URI" you entered in Google Cloud.
# GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback
# Where the browser returns after the Google consent screen (the web app's address).
# WEB_BASE_URL=http://localhost:5173
#
# Encrypts the Google tokens and Bing API keys stored in the database (Fernet key). Leave unset in local
# development: a key is derived from JWT_SECRET (with a warning in the log). REQUIRED in production, and keep
# it: if it changes, stored connections can't be read and must be re-created. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEY=
#
# PageSpeed Insights API key (optional; works without one but with a very small quota).
# PSI_API_KEY=
# Set to false to switch off the PageSpeed step of audits.
# PSI_ENABLED=true
